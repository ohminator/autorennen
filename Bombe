import sum.kern.*;
import java.io.File;
import java.awt.Desktop; // NEU: Ermöglicht das Öffnen von Dateien mit dem Standardprogramm

public class Bombe
{
    private double AnfangH;
    private double AnfangV;
    private Buntstift hatBuntstift;
    private Bildschirm derBildschirm;
    private Auto Auto1;
    private Auto Auto2;
    
    private boolean istExplodiert;
    private boolean spielVorbei;

    public Bombe(double pAnfangH, double pAnfangV, Auto pAuto1, Auto pAuto2)
    {
        AnfangH = pAnfangH;
        AnfangV = pAnfangV;
        
        Auto1 = pAuto1;
        Auto2 = pAuto2;
        
        hatBuntstift = new Buntstift();
        istExplodiert = false;
        spielVorbei = false;
    }

    // Löscht die Bombe an der alten Position
    public void loesche()
    {
        hatBuntstift.radiere();
        zeichne();
        hatBuntstift.normal();
    }

    // Zeichnet die eigentliche Form der Bombe
    public void zeichne()
    {
        hatBuntstift.hoch();
        hatBuntstift.bewegeBis(AnfangH, AnfangV);
        hatBuntstift.dreheBis(0); 
        
        hatBuntstift.runter();
        hatBuntstift.setzeLinienBreite(2);
        
        hatBuntstift.bewegeUm(50);
        hatBuntstift.dreheUm(90);
        hatBuntstift.bewegeUm(30);
        hatBuntstift.dreheUm(90);
        hatBuntstift.bewegeUm(50);
        hatBuntstift.dreheUm(90);
        hatBuntstift.bewegeUm(30);
        
        hatBuntstift.dreheUm(180);
        hatBuntstift.bewegeUm(15);
        hatBuntstift.dreheUm(-90);
        hatBuntstift.schreibeText("Kaboom");
        
        hatBuntstift.hoch();
    }

    public void zeichne_dashieristeineganzdummemethodedienichtskannundniemandvermissenwird()
    {
        if (spielVorbei) return;
        zeichne();
    }

    public void zeichneGameOver()
    {
        hatBuntstift.hoch();
        hatBuntstift.dreheBis(0); 
        hatBuntstift.bewegeBis(250, 400); 
        hatBuntstift.runter();
        hatBuntstift.setzeLinienBreite(5);
        hatBuntstift.schreibeText("GAME OVER! Rick Roll startet...");
        hatBuntstift.hoch();
        
        // ÄNDERUNG: Ruft die neue Methode für die MP4-Datei auf
        this.oeffneDatei("\\SUGPSRV01\\StudentsHome$\\Luis.Da\\Data\\Download\\kaboom-yes-rico-kaboom.mp4");
    }

    // NEU: Diese Methode öffnet jede Datei (MP4, MP3, WAV, etc.) im passenden Standardprogramm/Browser
    private void oeffneDatei(String dateiPfad)
    {
        try {
            File datei = new File(dateiPfad);
            if (datei.exists()) {
                // Nutzt das Betriebssystem, um das Video im Standard-Player oder Browser zu starten
                Desktop.getDesktop().open(datei);
            } else {
                System.out.println("Datei nicht gefunden: " + datei.getAbsolutePath());
            }
        } catch (Exception e) {
            System.out.println("Fehler beim Öffnen der Datei: " + e.getMessage());
        }
    }

    public double getH()
    {
        return AnfangH;
    }

    public double getV()
    {
        return AnfangV;
    }

    public void merke(Bildschirm pBildschirm)
    {
        derBildschirm = pBildschirm;
    }

    public boolean istSpielVorbei()
    {
        return spielVorbei;
    }
    
    public void kollisionpruefen()
    { 
        double v1 = Auto1.vPosition();
        double v2 = Auto2.vPosition();
        double h1 = Auto1.hPosition();
        double h2 = Auto2.hPosition();
        
        if (((v1 >= (AnfangV - 5) && v1 <= (AnfangV + 5)) ||
         (v2 >= (AnfangV - 5) && v2 <= (AnfangV + 5)))
        &&
        ((h1 >= (AnfangH - 5) && h1 <= (AnfangH + 5)) ||
         (h2 >= (AnfangH - 5) && h2 <= (AnfangH + 5))))
        {
            zeichneGameOver();
        }
    }
}
